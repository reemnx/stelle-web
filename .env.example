# Local development: copy to .env and restart npm run dev after changes.
# Cloudflare Pages: set these in Settings > Variables and Secrets, then redeploy.
# Encrypt MAILJET_API_KEY and MAILJET_API_SECRET as secrets.
# NEVER prefix any of these variables with VITE_.
MAILJET_API_KEY=
MAILJET_API_SECRET=
# Must be a verified Mailjet sender.
MAILJET_FROM_EMAIL=
MAILJET_FROM_NAME=STELLÉ
# Your inbox for checkout leads (one address).
MAILJET_TO_EMAIL=
